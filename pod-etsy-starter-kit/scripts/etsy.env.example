# Copy this file to a local, untracked .env file or export the variables in your shell.
# Never commit real Etsy tokens.

# Etsy app keystring / client ID from your Etsy developer app.
ETSY_API_KEY=replace_me

# OAuth access token with listing write permissions.
ETSY_ACCESS_TOKEN=replace_me

# Your Etsy shop ID, not the shop name.
ETSY_SHOP_ID=replace_me

# Etsy taxonomy ID for the chosen T-shirt category.
ETSY_TAXONOMY_ID_TSHIRT=replace_me

# Shipping profile ID configured in your Etsy shop.
ETSY_SHIPPING_PROFILE_ID=replace_me

# Optional, if your Etsy account/API flow requires it.
ETSY_RETURN_POLICY_ID=replace_me
